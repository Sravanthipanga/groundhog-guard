# Groundhog Guard configuration (all values have local-dev defaults; Docker
# Compose sets its own — these are for running the binary directly).

# Postgres DSN (pgx).
DATABASE_URL=postgres://groundhog:groundhog@localhost:5432/groundhog?sslmode=disable

# Valkey/Redis address (dedup fast path).
VALKEY_ADDR=localhost:6379

# Kafka bootstrap brokers, comma-separated.
# Against the compose stack from the host: localhost:9092.
KAFKA_BROKERS=localhost:9092

# Listen address for `groundhog api`.
HTTP_ADDR=:8080

# Listen address for the standalone metrics server (relay/consumer).
METRICS_ADDR=:9091

# Base URL of the API — used by `groundhog chaos`.
API_URL=http://localhost:8080
